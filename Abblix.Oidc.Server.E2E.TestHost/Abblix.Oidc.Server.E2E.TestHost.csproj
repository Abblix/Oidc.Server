<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- S1075: hardcoded URIs are intentional in this test host (canonical
         issuer / redirect URIs match the test conventions). -->
    <NoWarn>$(NoWarn);S1075</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abblix.Oidc.Server\Abblix.Oidc.Server.csproj" />
    <ProjectReference Include="..\Abblix.Oidc.Server.Mvc\Abblix.Oidc.Server.Mvc.csproj" />
  </ItemGroup>

  <!-- Expose internal Program to the E2E.Tests assembly so WebApplicationFactory<Program>
       can bind to the top-level statements' synthesised Program type. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Abblix.Oidc.Server.E2E.Tests" />
  </ItemGroup>

</Project>
