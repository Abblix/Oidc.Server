root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml,xml,slnx,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion

# Size and complexity at Sonar's default limits, held by the build rather than by the dashboard: warnings
# are errors here, so a file, class or method growing past one fails where the change is made. A method
# that is one exhaustive switch over a set of values becomes a table a test holds complete; one with real
# logic is split along a named pattern. Never suppressed.
dotnet_diagnostic.S104.severity = warning
dotnet_diagnostic.S138.severity = warning
dotnet_diagnostic.S1541.severity = warning
dotnet_diagnostic.S1200.severity = warning
dotnet_diagnostic.S134.severity = warning
# Expression complexity is held by ABX1005 from src/Abblix.Analyzers rather than S1067, which also counts the
# cases a pattern lists with `or` and `and` and so splits an exhaustive switch into arms repeating one answer.

# One Sonar rule CRASHES on a union declaration rather than reporting anything: the analyzer throws
# NullReferenceException, which arrives as AD0001 and fails the build here, where warnings are errors.
# Reproduced on the newest analyzer available as well, so it is a gap in the tool rather than a stale
# pin. Scoped to the file that declares a union rather than turned off everywhere - the list growing is
# the reminder that this is owed back to the analyzer, not a decision to stop checking.
[src/Abblix.Utils/Result.cs]
dotnet_diagnostic.S1117.severity = none
