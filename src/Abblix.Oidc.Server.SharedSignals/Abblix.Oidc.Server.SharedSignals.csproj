<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Abblix.OIDC.Server.SharedSignals</PackageId>
    <Title>Abblix OIDC Server Shared Signals</Title>
    <Description>Runs an Abblix Shared Signals transmitter on a multi-tenant Abblix OIDC Server: each tenant's streams, queued events, delivery claims, issuer and signing keys are its own.</Description>
    <Authors>Abblix LLP</Authors>
    <PackageProjectUrl>https://github.com/Abblix/Oidc.Server/tree/master/src/Abblix.Oidc.Server.SharedSignals</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Abblix/Oidc.Server</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Abblix Shared-Signals SSF OpenID Security-Event-Token SET Transmitter Multi-Tenancy Multi-Tenant OIDC OAuth2 Identity Continuous-Access-Evaluation Zero-Trust dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <Copyright>Copyright (c) $([System.DateTime]::Now.Year) Abblix LLP. All rights reserved.</Copyright>
    <PackageReleaseNotes>Runs a Shared Signals transmitter per tenant on a multi-tenant server. Full details: https://github.com/Abblix/Oidc.Server/releases/tag/v3.0</PackageReleaseNotes>
    <PackageIcon>Abblix.png</PackageIcon>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abblix.Oidc.Server\Abblix.Oidc.Server.csproj" />
    <ProjectReference Include="..\Abblix.SharedSignals\Abblix.SharedSignals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Abblix.png" Link="Abblix.png" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE.md" Link="LICENSE.md" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
