{
  "description": "Abblix OIDC Server conformance host",
  "server": {
    "discoveryUrl": "https://oidc-host:9443/.well-known/openid-configuration"
  },
  "client": {
    "client_name": "first-openid-client"
  },
  "client2": {
    "client_name": "second-openid-client"
  },
  "browser": [
    {
      "match": "https://oidc-host:9443/connect/authorize*",
      "tasks": [
        {
          "task": "Sign in",
          "optional": true,
          "match": "https://oidc-host:9443/login*",
          "commands": [
            [
              "text",
              "name",
              "email",
              "conformance@example.com"
            ],
            [
              "text",
              "name",
              "password",
              "conformance"
            ],
            [
              "click",
              "id",
              "sign-in"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    },
    {
      "comment": "logout asks the end user nothing: the browser goes on to the client's post-logout address",
      "match": "https://oidc-host:9443/connect/endsession*",
      "tasks": [
        {
          "task": "Wait for the way back",
          "optional": true,
          "match": "https://oidc-host:9443/connect/endsession*",
          "commands": [
            [
              "wait",
              "contains",
              "/post",
              10
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/post*"
        }
      ]
    },
    {
      "comment": "the suite's own page reads the session through the provider's check_session_iframe and reports the result",
      "match": "*/test/*session_verify*",
      "tasks": [
        {
          "task": "Wait for the session check",
          "match": "*/test/*session_verify*",
          "commands": [
            [
              "wait",
              "contains",
              "session_result",
              20
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*session_result*"
        }
      ]
    }
  ],
  "override": {
    "oidcc-prompt-login": {
      "browser": [
        {
          "comment": "the second authorization shows the sign-in page again, which the test wants a picture of",
          "match": "https://oidc-host:9443/connect/authorize*",
          "tasks": [
            {
              "task": "Sign in",
              "optional": true,
              "match": "https://oidc-host:9443/login*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "name",
                  "email",
                  "conformance@example.com"
                ],
                [
                  "text",
                  "name",
                  "password",
                  "conformance"
                ],
                [
                  "click",
                  "id",
                  "sign-in"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
