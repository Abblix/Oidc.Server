    "oidcc-ensure-registered-redirect-uri": {
      "browser": [
        {
          "comment": "an unregistered redirect_uri is answered in place, never redirected to",
          "match": "https://oidc-host:9443/connect/authorize*",
          "tasks": [
            {
              "task": "Expect the redirect URI error",
              "match": "https://oidc-host:9443/connect/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "redirect URI is not valid",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    },
